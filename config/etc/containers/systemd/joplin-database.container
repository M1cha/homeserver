[Unit]
Description=joplin-database
After=network.target

[Container]
ContainerName=joplin-database
Image=docker.io/postgres:16
AutoUpdate=registry
Network=brvirt:host_interface_name=veth_joplin_db
Volume=joplin_database:/var/lib/postgresql/data:idmap
Environment=POSTGRES_DB=joplin
Environment=POSTGRES_USER=joplin
Environment=POSTGRES_PASSWORD=joplin

[Service]
Restart=always
RestartMode=direct
RestartSec=10

[Install]
WantedBy=multi-user.target
