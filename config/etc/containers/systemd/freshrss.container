[Unit]
Description=freshrss
After=network.target freshrss-database.service
Requires=freshrss-database.service

[Container]
ContainerName=freshrss
Image=docker.io/freshrss/freshrss:latest
DNS=none
Volume=/usr/local/share/resolv-inet.conf:/etc/resolv.conf:ro,idmap,z
Network=brvirt:host_interface_name=veth_freshrss
Volume=freshrss_data:/var/www/FreshRSS/data:idmap
Volume=freshrss_extensions:/var/www/FreshRSS/extensions:idmap
Volume=freshrss_extensions:/var/www/FreshRSS/extensions:idmap
Environment=CRON_MIN=1,31
Environment=BASE_URL=https://freshrss.home.arpa
Environment=SERVER_DNS=freshrss.home.arpa
Environment=DB_HOST=freshrss-database
Environment=DB_BASE=freshrss
Environment=DB_USER=freshrss
Environment=DB_PASSWORD=freshrss

[Service]
Restart=always
RestartMode=direct
RestartSec=10

[Install]
WantedBy=multi-user.target
