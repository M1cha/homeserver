[Unit]
Description=joplin-server
After=network.target joplin-database.service
Requires=joplin-database.service

[Container]
ContainerName=joplin-server
Image=docker.io/joplin/server:amd64-3
AutoUpdate=registry
Network=brvirt:host_interface_name=veth_joplin_srv
Volume=joplin_storage:/var/lib/joplin-storage:idmap,z
Environment=APP_PORT=22300
Environment=APP_BASE_URL=https://joplin.home.arpa
Environment=DB_CLIENT=pg
Environment=POSTGRES_PASSWORD=joplin
Environment=POSTGRES_DATABASE=joplin
Environment=POSTGRES_USER=joplin
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_HOST=joplin-database
Environment=STORAGE_DRIVER=Type=Filesystem;Path=/var/lib/joplin-storage
Environment=MAX_TIME_DRIFT=0

[Service]
Restart=always
RestartMode=direct
RestartSec=10

[Install]
WantedBy=multi-user.target
