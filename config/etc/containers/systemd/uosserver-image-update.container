[Unit]
Description=Update uosserver container image
After=network.target

[Service]
Type=oneshot
ExecStopPost=/usr/local/share/uosserver-image-update/import

[Container]
Network=brvirt:host_interface_name=veth_uoss_img
DNS=none
Volume=/usr/local/share/resolv-inet.conf:/etc/resolv.conf:ro,idmap,z
UserNS=auto
ContainerName=uosserver-image-update
Image=localhost/homeserver-universal:latest
Volume=uosserver_image:/run/media/cache:idmap,z
Volume=/usr/local/share/uosserver-image-update/download:/run/media/config/download:idmap,ro
Exec=/run/media/config/download
