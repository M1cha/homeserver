[Unit]
Description=freshrss traefik
After=network.target freshrss.service

[Container]
ContainerName=freshrss-traefik
Image=docker.io/traefik:latest
AutoUpdate=registry
Network=brvirt:host_interface_name=veth_frss_prox
Volume=/usr/local/share/freshrss-traefik:/etc/traefik:ro,idmap,z
Secret=freshrss_https_key
Secret=freshrss_https_cert

[Service]
Restart=always
RestartMode=direct
RestartSec=10

[Install]
WantedBy=multi-user.target
