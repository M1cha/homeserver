#!/bin/bash

set -euo pipefail

script=$(readlink -f "$0")

if [ "${container:-}" != "podman" ]; then
	exec podman run \
		--rm \
		-it \
		--init \
		--userns auto:size=65536 \
		--network brvirt:host_interface_name=veth_uoss_upd \
		--dns=none \
		-v /usr/local/share/resolv-inet.conf:/etc/resolv.conf:ro,idmap,z \
		-v "$script:/entrypoint:ro,idmap" \
		-v uosserver_persistent:/persistent:idmap,z \
		--entrypoint /entrypoint \
		localhost/uosserver:latest
fi

export UOS_SERVER_VERSION=$(dpkg-query -W -f='${Version}' uos-agent)
echo "UOSSERVER.0000000.$UOS_SERVER_VERSION.0000000.000000.0000" > /usr/lib/version

echo -e '#!/bin/sh\nshift 1; exec "$@"' > /usr/bin/systemd-cat

exec uos runnable install --progress --max-release-channel release unifi
